# Postgres connection string (oracle_vm 운영: postgresql://triplan:<pw>@127.0.0.1:5432/postgres)
# 로컬 docker Postgres 예: postgres://postgres:triplan@localhost:5433/triplan
DATABASE_URL=postgres://postgres:triplan@localhost:5433/triplan

# 관리자 비밀번호 (여행 목록·생성·삭제·위시리스트·공유 링크 관리)
ADMIN_PASSWORD=
# 로그인 쿠키 서명용 임의 문자열 (32자 이상 권장, 예: openssl rand -base64 32)
SESSION_SECRET=

# 선택: 공유 링크 미리보기(og:image) 절대 주소의 기준. 예: https://triplan-beryl.vercel.app
# 없으면 요청 헤더(x-forwarded-proto/x-forwarded-host, 없으면 host)로 만든다
SITE_URL=

# 선택: 지도 (없으면 무료 MapLibre + Carto 지도 사용)
NEXT_PUBLIC_MAPBOX_TOKEN=
# 선택: 국내 장소 검색 (없으면 해외 검색용 Photon만 사용)
KAKAO_REST_KEY=
# 선택: 장소 이름·지도 라벨 번역(MyMemory 무료 API)에 쓸 이메일. 넣으면 하루 한도가 5천 자 → 5만 자
MYMEMORY_EMAIL=
# 선택: 환율 API 키 (없어도 open.er-api 무료 엔드포인트, 실패 시 대략 환율 사용)
EXCHANGE_RATE_API_KEY=
# 선택: 한국 대중교통 경로 (ODsay LAB 무료 키, 하루 30건, 등록한 서버 IP에서만 동작). 없으면 대중교통은 추정 시간만
ODSAY_API_KEY=
# 선택: 후보함 구역 이름 짓기 (NVIDIA NIM). 없으면 동네 이름(Photon)이나 "구역 N"
NVIDIA_API_KEY=
# 선택: 소개 화면의 "샘플 여행 둘러보기" 버튼이 여는 보기 링크 경로 (예: /v/abc123). 비우면 버튼을 숨긴다
SAMPLE_TRIP_PATH=
